{
  "manifest_version": 3,
  "name": "bind-my-tabs",
  "version": "1.2.0",
  "description": "Minimalist tab switching and history daemon via browser commands.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "commands": {
    "next-tab": {
      "suggested_key": {
        "default": "Ctrl+L",
        "mac": "Command+L"
      },
      "description": "Switch to next tab"
    },
    "prev-tab": {
      "suggested_key": {
        "default": "Ctrl+O",
        "mac": "Command+O"
      },
      "description": "Switch to previous tab"
    },
    "history-back": {
      "suggested_key": {
        "default": "Ctrl+Z",
        "mac": "Command+Z"
      },
      "description": "Go back in active tab history"
    },
    "history-forward": {
      "suggested_key": {
        "default": "Ctrl+X",
        "mac": "Command+X"
      },
      "description": "Go forward in active tab history"
    }
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "bind-my-tabs",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
